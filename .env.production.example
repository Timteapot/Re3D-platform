# Copy this file to .env.production on the deployment host. The copied file is
# ignored by Git. Every replace-* value must be supplied through a secret store
# or edited only on the host; never commit real credentials.
APP_ENV=production
APP_PUBLIC_BASE_URL=https://re3d.example.com
API_HOST=127.0.0.1
API_PORT=8000

# Use only the re3d_runtime role here. re3d_migrator is reserved for controlled
# migrations/backups. URL-encode password characters. Never use a dev/test DB.
DATABASE_URL=postgresql+psycopg://re3d_runtime:replace-with-database-password@127.0.0.1:5432/re3d_platform

# Generate at least 32 random bytes. Do not reuse a development secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=re3d-platform
JWT_AUDIENCE=re3d-platform-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=re3d_refresh
REFRESH_COOKIE_SECURE=true

# For a same-host reverse proxy, loopback is the usual trust boundary. Replace
# these networks if the proxy is on another private network. Never use 0.0.0.0/0.
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Select these values for expected public traffic. Production readiness rejects
# missing values; do not rely on development defaults.
API_IP_RATE_LIMIT_WINDOW_SECONDS=replace-with-operator-window-seconds
API_IP_RATE_LIMIT_MAX_REQUESTS=replace-with-operator-request-limit
# Per-user limits shared by every API process through PostgreSQL. Start from
# these defaults, then replace them with values validated on the target host.
TRANSFER_WINDOW_SECONDS=3600
TRANSFER_UPLOAD_MAX_CONCURRENT=2
TRANSFER_UPLOAD_MAX_BYTES=2147483648
TRANSFER_DOWNLOAD_MAX_CONCURRENT=3
TRANSFER_DOWNLOAD_MAX_BYTES=4294967296
TRANSFER_LEASE_SECONDS=14400
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=30
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_REGISTRATION_WINDOW_MINUTES=60
AUTH_REGISTRATION_IDENTITY_MAX_ATTEMPTS=3
AUTH_REGISTRATION_IP_MAX_ATTEMPTS=10
AUTH_REGISTRATION_BLOCK_MINUTES=60
AUTH_ACTION_REQUEST_WINDOW_MINUTES=60
AUTH_ACTION_REQUEST_IDENTITY_MAX_ATTEMPTS=3
AUTH_ACTION_REQUEST_IP_MAX_ATTEMPTS=10
AUTH_ACTION_REQUEST_BLOCK_MINUTES=60
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_EVENT_RETENTION_DAYS=90
AUTH_ACTION_TOKEN_RETENTION_DAYS=7
AUTH_THROTTLE_RETENTION_DAYS=7
AUTH_CLEANUP_BATCH_SIZE=1000

UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_TOTAL_BYTES=1073741824
UPLOAD_MAX_PIXELS=50000000
UPLOAD_STALE_AFTER_HOURS=24
UPLOAD_CLEANUP_BATCH_SIZE=100

# Operator-selected per-user task limits. Replace both placeholders before the
# production readiness check can pass.
RE3D_USER_MAX_PENDING_JOBS=replace-with-operator-limit
RE3D_USER_MAX_SUBMISSIONS_PER_24H=replace-with-operator-limit
# Select these after measuring real Re3D peak task storage. The reservation must
# be at least 1 GiB and UPLOAD_MAX_TOTAL_BYTES, and no greater than the quota.
RE3D_USER_STORAGE_QUOTA_BYTES=replace-with-operator-byte-limit
RE3D_JOB_STORAGE_RESERVATION_BYTES=replace-with-operator-byte-reservation

# The first production topology uses Windows path semantics for the API data
# writer and GPU worker. Keep data outside both source repositories.
RE3D_ROOT=D:/3Dreconstruction/Re3D
RE3D_DATA_ROOT=D:/3Dreconstruction/Re3D-data-production
RE3D_DRIVER_PYTHON=
RE3D_GPU_RESOURCE=gpu:0
RE3D_LEASE_SECONDS=60
RE3D_HEARTBEAT_SECONDS=20
RE3D_WORKER_POLL_SECONDS=5
RE3D_WORKER_ID=windows-gpu-production-01
RE3D_FAILED_JOB_CLEANUP_GRACE_MINUTES=5
RE3D_FAILED_JOB_CLEANUP_INTERVAL_SECONDS=300
RE3D_FAILED_JOB_CLEANUP_BATCH_SIZE=100
RE3D_RESOURCE_MONITOR_ENABLED=true
RE3D_RESOURCE_SAMPLE_INTERVAL_SECONDS=15
RE3D_TASK_STORAGE_SAMPLE_INTERVAL_SECONDS=60
RE3D_NVIDIA_SMI_PATH=C:/Windows/System32/nvidia-smi.exe

# Successful-task data is retained for 30 days. The cleanup command remains a
# dry-run unless --execute is supplied explicitly.
SUCCESS_INPUT_RETENTION_DAYS=30
SUCCESS_RUNTIME_RETENTION_DAYS=30
SUCCESS_ARTIFACT_RETENTION_DAYS=30
SUCCESS_RETENTION_CLEANUP_BATCH_SIZE=50
SUCCESS_RETENTION_DRY_RUN_ENABLED=true
SUCCESS_RETENTION_DRY_RUN_INTERVAL_SECONDS=86400

# Explicit operator-selected safety floor. 53687091200 bytes = 50 GiB. Replace
# it after estimating concurrent uploads, intermediate files and retention.
RE3D_MIN_FREE_DISK_BYTES=53687091200

# A public deployment requires a real authenticated SMTP service with STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@re3d.example.com
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
