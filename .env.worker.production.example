# Copy to .env.worker.production on the Windows GPU host. This file contains no
# web JWT or SMTP secrets. Replace all credentials only on the deployment host.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://re3d_runtime:replace-with-database-password@127.0.0.1:5432/re3d_platform

RE3D_ROOT=D:/3Dreconstruction/Re3D
RE3D_DATA_ROOT=D:/3Dreconstruction/Re3D-data-production
RE3D_DRIVER_PYTHON=
RE3D_GPU_RESOURCE=gpu:0
RE3D_LEASE_SECONDS=60
RE3D_HEARTBEAT_SECONDS=20
RE3D_WORKER_POLL_SECONDS=5
RE3D_WORKER_ID=windows-gpu-production-01
RE3D_MIN_FREE_DISK_BYTES=53687091200
