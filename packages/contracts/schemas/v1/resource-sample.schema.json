{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:re3d-platform:schema:resource-sample:1.0",
  "title": "Re3D Private Resource Sample",
  "description": "One private worker resource sample for a real reconstruction task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sample_id",
    "job_id",
    "attempt",
    "sampled_at",
    "worker_id",
    "status",
    "cpu",
    "memory",
    "disk",
    "gpu",
    "errors"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "sample_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "sampled_at": { "type": "string", "format": "date-time" },
    "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "status": { "enum": ["warming_up", "complete", "partial"] },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utilization_percent", "logical_count"],
      "properties": {
        "utilization_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "logical_count": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "memory": { "$ref": "#/$defs/capacity" },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_bytes", "free_bytes", "total_bytes", "utilization_percent"],
      "properties": {
        "used_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "free_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "total_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "utilization_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "task_storage": {
      "$ref": "#/$defs/taskStorage"
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "index",
        "name",
        "utilization_percent",
        "memory_used_bytes",
        "memory_total_bytes",
        "temperature_c",
        "error_code"
      ],
      "properties": {
        "status": { "enum": ["available", "unavailable", "error"] },
        "index": { "type": ["integer", "null"], "minimum": 0 },
        "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "utilization_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "memory_used_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "memory_total_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "temperature_c": { "type": ["number", "null"], "minimum": -100, "maximum": 200 },
        "error_code": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_bytes", "total_bytes", "utilization_percent"],
      "properties": {
        "used_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "total_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "utilization_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "taskStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_bytes",
        "input_bytes",
        "runtime_bytes",
        "output_bytes",
        "reports_bytes",
        "manifests_bytes",
        "other_bytes",
        "branches"
      ],
      "properties": {
        "total_bytes": { "type": "integer", "minimum": 0 },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "runtime_bytes": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "reports_bytes": { "type": "integer", "minimum": 0 },
        "manifests_bytes": { "type": "integer", "minimum": 0 },
        "other_bytes": { "type": "integer", "minimum": 0 },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/branchBytes" }
        }
      }
    },
    "branchBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "used_bytes"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
        },
        "used_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
