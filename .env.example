APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000

# Replace all development credentials before use. Never commit a real .env file.
# Local development database. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://re3d_app:change-me@127.0.0.1:5432/re3d_platform_dev
# Tests must point this at a disposable Docker PostgreSQL instance, never the dev DB.
RE3D_TEST_DATABASE_URL=
RE3D_GPU_RESOURCE=gpu:0
RE3D_LEASE_SECONDS=60
RE3D_HEARTBEAT_SECONDS=20
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=re3d-platform
JWT_AUDIENCE=re3d-platform-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=re3d_refresh
# Development is HTTP on loopback. Production rejects false and requires HTTPS.
REFRESH_COOKIE_SECURE=false
# Failed-login window and thresholds. The IP limit must be at least the account limit.
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=30
AUTH_LOGIN_BLOCK_MINUTES=15
# Registration attempts include successful and duplicate-identity requests.
AUTH_REGISTRATION_WINDOW_MINUTES=60
AUTH_REGISTRATION_IDENTITY_MAX_ATTEMPTS=3
AUTH_REGISTRATION_IP_MAX_ATTEMPTS=10
AUTH_REGISTRATION_BLOCK_MINUTES=60
AUTH_ACTION_REQUEST_WINDOW_MINUTES=60
AUTH_ACTION_REQUEST_IDENTITY_MAX_ATTEMPTS=3
AUTH_ACTION_REQUEST_IP_MAX_ATTEMPTS=10
AUTH_ACTION_REQUEST_BLOCK_MINUTES=60
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# Comma-separated CIDRs whose X-Forwarded-For chain may be trusted. Required in production.
# Use only the actual reverse-proxy networks; do not trust arbitrary public ranges.
AUTH_TRUSTED_PROXY_CIDRS=
# Periodic cleanup keeps recent security evidence and removes inactive throttle state.
AUTH_EVENT_RETENTION_DAYS=90
AUTH_ACTION_TOKEN_RETENTION_DAYS=7
AUTH_THROTTLE_RETENTION_DAYS=7
AUTH_CLEANUP_BATCH_SIZE=1000

# Authenticated image upload limits for the local development API.
UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_TOTAL_BYTES=1073741824
UPLOAD_MAX_PIXELS=50000000
UPLOAD_STALE_AFTER_HOURS=24
UPLOAD_CLEANUP_BATCH_SIZE=100
# Per-user limits enforced transactionally when an upload becomes a job.
RE3D_USER_MAX_PENDING_JOBS=3
RE3D_USER_MAX_SUBMISSIONS_PER_24H=20

RE3D_ROOT=D:/3Dreconstruction/Re3D
RE3D_DATA_ROOT=D:/3Dreconstruction/Re3D-data
# Optional; when empty, the adapter reads mapanything_python from Re3D paths.local.json.
RE3D_DRIVER_PYTHON=
RE3D_PIPELINE_TAG=re3d-pipeline-v1.1.0
RE3D_PIPELINE_COMMIT=2c5ba174dae9fe53dcec8f7d8466793fdebf0c58
RE3D_BRANCHES=A-v4,B-v2,C
RE3D_GPU_CONCURRENCY=1
RE3D_WORKER_ID=windows-gpu-01
RE3D_RESOURCE_MONITOR_ENABLED=true
RE3D_RESOURCE_SAMPLE_INTERVAL_SECONDS=15
# Optional on Linux when nvidia-smi is already on PATH.
RE3D_NVIDIA_SMI_PATH=C:/Windows/System32/nvidia-smi.exe

DELETE_FAILED_TASK_FILES=true

# Required before public deployment. Values remain intentionally undecided.
# SUCCESS_INPUT_RETENTION_DAYS=30
# SUCCESS_RUNTIME_RETENTION_DAYS=30
# SUCCESS_ARTIFACT_RETENTION_DAYS=30

# Local defaults match deploy/mailpit. Configure a real SMTP service before public registration.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@example.invalid
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
