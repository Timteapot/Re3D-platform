{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:re3d-platform:schema:storage-capacity-report:1.0",
  "title": "Re3D Storage Capacity Calibration Report",
  "description": "Private aggregate report derived from complete task storage summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation",
    "generated_at",
    "status",
    "selection",
    "percentile_method",
    "safety_factor",
    "rounding_bytes",
    "task_peak_bytes",
    "final_tiers",
    "branches",
    "recommendation",
    "limitations"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "operation": { "const": "report-storage-capacity" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "insufficient_data"] },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_summaries",
        "complete_samples",
        "excluded_non_complete_samples",
        "invalid_samples",
        "minimum_samples"
      ],
      "properties": {
        "discovered_summaries": { "type": "integer", "minimum": 0 },
        "complete_samples": { "type": "integer", "minimum": 0 },
        "excluded_non_complete_samples": { "type": "integer", "minimum": 0 },
        "invalid_samples": { "type": "integer", "minimum": 0 },
        "minimum_samples": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "percentile_method": { "const": "NEAREST_RANK" },
    "safety_factor": { "type": "number", "minimum": 1, "maximum": 5 },
    "rounding_bytes": { "type": "integer", "minimum": 1 },
    "task_peak_bytes": {
      "oneOf": [
        { "$ref": "#/$defs/statistics" },
        { "type": "null" }
      ]
    },
    "final_tiers": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/tierStatistics" }
    },
    "branches": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/branchStatistics" }
    },
    "recommendation": {
      "oneOf": [
        { "$ref": "#/$defs/recommendation" },
        { "type": "null" }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ready" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "task_peak_bytes": { "$ref": "#/$defs/statistics" },
          "final_tiers": { "minItems": 6 },
          "branches": { "minItems": 3 },
          "recommendation": { "$ref": "#/$defs/recommendation" }
        }
      },
      "else": {
        "properties": {
          "recommendation": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_bytes", "p95_bytes", "maximum_bytes"],
      "properties": {
        "p50_bytes": { "type": "integer", "minimum": 0 },
        "p95_bytes": { "type": "integer", "minimum": 0 },
        "maximum_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "tierStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "p50_bytes",
        "p95_bytes",
        "maximum_bytes",
        "aggregate_share_percent"
      ],
      "properties": {
        "name": {
          "enum": ["input", "runtime", "output", "reports", "manifests", "other"]
        },
        "p50_bytes": { "type": "integer", "minimum": 0 },
        "p95_bytes": { "type": "integer", "minimum": 0 },
        "maximum_bytes": { "type": "integer", "minimum": 0 },
        "aggregate_share_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "branchStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "p50_bytes",
        "p95_bytes",
        "maximum_bytes",
        "aggregate_output_share_percent"
      ],
      "properties": {
        "name": { "enum": ["A-v4", "B-v2", "C"] },
        "p50_bytes": { "type": "integer", "minimum": 0 },
        "p95_bytes": { "type": "integer", "minimum": 0 },
        "maximum_bytes": { "type": "integer", "minimum": 0 },
        "aggregate_output_share_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "observed_maximum_bytes",
        "scaled_bytes",
        "recommended_reservation_bytes"
      ],
      "properties": {
        "basis": { "const": "OBSERVED_MAXIMUM_PEAK" },
        "observed_maximum_bytes": { "type": "integer", "minimum": 0 },
        "scaled_bytes": { "type": "integer", "minimum": 0 },
        "recommended_reservation_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
