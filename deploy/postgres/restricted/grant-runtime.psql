\set ON_ERROR_STOP on

REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE, CREATE ON SCHEMA public TO re3d_restricted_migrator;
GRANT USAGE ON SCHEMA public TO re3d_restricted_runtime;
REVOKE CREATE ON SCHEMA public FROM re3d_restricted_runtime;

REVOKE ALL ON ALL TABLES IN SCHEMA public FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE, DELETE
    ON ALL TABLES IN SCHEMA public TO re3d_restricted_runtime;
REVOKE TRUNCATE, REFERENCES, TRIGGER
    ON ALL TABLES IN SCHEMA public FROM re3d_restricted_runtime;

REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM PUBLIC;
GRANT USAGE, SELECT
    ON ALL SEQUENCES IN SCHEMA public TO re3d_restricted_runtime;

ALTER DEFAULT PRIVILEGES FOR ROLE re3d_restricted_migrator IN SCHEMA public
    REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE re3d_restricted_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES
    TO re3d_restricted_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE re3d_restricted_migrator IN SCHEMA public
    REVOKE ALL ON SEQUENCES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE re3d_restricted_migrator IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO re3d_restricted_runtime;

REVOKE INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER
    ON TABLE public.alembic_version FROM re3d_restricted_runtime;
GRANT SELECT ON TABLE public.alembic_version TO re3d_restricted_runtime;
